{
    "name": "sunrice/commerce",
    "description": "An e-commerce package for Sunrice CMS: catalog, cart, checkout, orders, payments, shipping, promotions and customer accounts.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sunrice",
        "laravel",
        "ecommerce",
        "shop"
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Digital-Citra-Kreatif/sunrice-cms"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/socialite": "^5.31",
        "spatie/laravel-one-time-passwords": "^1.1",
        "spatie/laravel-package-tools": "^1.93",
        "sunrice/cms": "dev-main"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Sunrice\\Commerce\\": "src/",
            "Sunrice\\Commerce\\Database\\Factories\\": "database/factories/",
            "Sunrice\\Commerce\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Sunrice\\Commerce\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sunrice\\Commerce\\CommerceServiceProvider"
            ],
            "aliases": {
                "Commerce": "Sunrice\\Commerce\\Facades\\Commerce"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
