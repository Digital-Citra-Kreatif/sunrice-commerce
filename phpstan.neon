includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    # The package's own config directory (env() belongs there).
    configDirectories:
        - config
    paths:
        - src/
        - config/
        - database/
    ignoreErrors:
        # Traits for listeners in other packages (and modules added in later phases).
        - identifier: trait.unused
        # Guards for Sunrice API added upstream (U2, U6, U11): always true on new Sunrice, needed on older.
        - identifier: function.alreadyNarrowedType
          paths:
              - src/CommerceServiceProvider.php
              - src/Storefront/PageCache.php
              - src/Admin/Dashboard/StoreCard.php
          reportUnmatched: false
