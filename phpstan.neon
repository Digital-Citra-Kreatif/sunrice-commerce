includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    # The package's own config directory (env() belongs there).
    configDirectories:
        - config
    paths:
        - src/
        - config/
        - database/
    ignoreErrors:
        # Traits for listeners in other packages (and modules added in later phases).
        - identifier: trait.unused
