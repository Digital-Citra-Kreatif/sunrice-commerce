{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "baseUrl": ".",
        "paths": { "@/*": ["resources/js/admin/*"] }
    },
    "include": ["resources/js/admin/**/*"]
}
